# =============================================================================
# CompraFlow — variáveis de ambiente (um .env = um cliente)
# Copie para .env e ajuste. Sem .env, os defaults abaixo são usados.
# =============================================================================

# ----------------------------- rede / TLS (proxy Caddy) ----------------------
# localhost -> certificado interno; domínio real -> Let's Encrypt automático
CADDY_DOMAIN=localhost
PORTA_HTTP=80
PORTA_HTTPS=443

# ----------------------------- dados / persistência --------------------------
# Pasta do banco SQLite e dos anexos dentro do volume
DATA_DIR=/data
# DATABASE_URL=sqlite:////data/compras.db        # (futuro: Postgres)
# ANEXOS_DIR=/data/anexos

# ----------------------------- conta administrativa --------------------------
# Troque ADMIN_SENHA_PADRAO em produção! Login no 1º acesso.
# A senha provisória do admin vale só por ADMIN_SENHA_VALIDADE_DIAS após o
# 1º boot (0 = sem bloqueio); depois, o login com ela é recusado.
ADMIN_EMAIL=admin@compraflow.com.br
ADMIN_SENHA_PADRAO=admin123
ADMIN_SENHA_VALIDADE_DIAS=7
SEED_ADMIN=true

# ----------------------------- rate limiting ---------------------------------
# Tentativas de autenticação (login/cadastro/reset) por IP+rota na janela
RATE_LIMIT_TENTATIVAS=10
RATE_LIMIT_JANELA_MIN=15

# ----------------------------- sessões ---------------------------------------
SESSAO_MINUTOS=480                # minutos (padrão 8h)
RESET_VALIDADE_MIN=30             # validade do link "esqueci minha senha"
# A sessão do navegador viaja em cookie httpOnly. COOKIE_SECURE=true quando
# servido por HTTPS (Caddy com TLS — padrão em produção).
COOKIE_SECURE=false

# ----------------------------- marca / identidade (white-label) --------------
# Aplicado no boot: título da página, sidebar, login, e-mails e paleta
# (a cor primária gera todos os tons no frontend). Veja CUSTOMIZACAO.md.
# Sem logo próprio, a SPA usa frontend/img/logo.svg — para trocá-lo,
# monte ./branding/logo.svg:/srv/frontend/img/logo.svg:ro no compose.
PRODUTO_NOME=CompraFlow
PRODUTO_COR_PRIMARIA=#1B7A43
# PRODUTO_LOGO_URL=                 # alternativa ao mount: logo servido de outra URL

# ----------------------------- e-mail institucional --------------------------
# Domínio aceito no auto-cadastro e domínio remetente dos e-mails
DOMINIO_EMAIL=compraflow.com.br

# ----------------------------- SMTP ("esqueci minha senha") ------------------
# Sem SMTP, o link de reset aparece no log do container (admin pode repassá-lo)
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_DE=noreply@compraflow.com.br
SMTP_TLS=true
# Base dos links de e-mail (ex.: https://compras.cliente.com.br). Em produção,
# configure SMTP_HOST; RESET_TOKEN_EM_LOG é apenas dev/homolog.
APP_BASE_URL=
RESET_TOKEN_EM_LOG=false

# ----------------------------- anexos ----------------------------------------
ANEXO_MAX_BYTES=10485760          # 10 MB

# ----------------------------- CORS ------------------------------------------
# Deixe vazio (SPA mesma origem). Ex.: "https://portal.cliente.com.br"
CORS_ORIGINS=

# ----------------------------- proxy / rate limiting -------------------------
# IPs de quem a API aceita X-Forwarded-For (uvicorn --proxy-headers). O
# default cobre as redes privadas do compose; se o cliente chega por outro
# proxy, inclua o IP dele. Rate limiting separa por este IP real.
FORWARDED_ALLOW_IPS=172.16.0.0/12,127.0.0.1,10.0.0.0/8,192.168.0.0/16

# ----------------------------- SSO corporativo (Microsoft Entra ID / OIDC) ---
# Híbrido: senha local continua valendo. Veja o passo a passo em DEPLOY.md
OIDC_ENABLED=false
OIDC_ISSUER=                      # ex.: https://login.microsoftonline.com/<TENANT-ID>/v2.0
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=                # ex.: https://compras.suaempresa.com.br/api/auth/sso/callback
OIDC_SPA_BASE=                    # ex.: https://compras.suaempresa.com.br
OIDC_SCOPES=openid profile email
SECRET_KEY=                       # OBRIGATÓRIA com SSO (string longa aleatória)

# ----------------------------- dados de demonstração -------------------------
# SEED_DEMO=true                   # cria usuários e requisições de exemplo (demo)
