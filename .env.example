# =============================================================================
# CompraFlow — variáveis de ambiente (um .env = um cliente)
# Copie para .env e ajuste. Sem .env, os defaults abaixo são usados.
# =============================================================================

# ----------------------------- rede / TLS (proxy Caddy) ----------------------
# localhost -> certificado interno; domínio real -> Let's Encrypt automático
CADDY_DOMAIN=localhost
PORTA_HTTP=80
PORTA_HTTPS=443

# ----------------------------- dados / persistência --------------------------
# Pasta do banco SQLite e dos anexos dentro do volume
DATA_DIR=/data
# DATABASE_URL=sqlite:////data/compras.db        # (futuro: Postgres)
# ANEXOS_DIR=/data/anexos

# ----------------------------- conta administrativa --------------------------
# Troque ADMIN_SENHA_PADRAO em produção! Login no 1º acesso.
ADMIN_EMAIL=admin@compraflow.com.br
ADMIN_SENHA_PADRAO=admin123
SEED_ADMIN=true

# ----------------------------- sessões ---------------------------------------
SESSAO_MINUTOS=480                # minutos (padrão 8h)
RESET_VALIDADE_MIN=30             # validade do link "esqueci minha senha"

# ----------------------------- marca / identidade (white-label) --------------
# (aplicado pelo backend na configuração pública /api/config)
# PRODUTO_NOME=CompraFlow
# PRODUTO_COR_PRIMARIA=#1B7A43
# PRODUTO_LOGO=/img/logo.svg

# ----------------------------- e-mail institucional --------------------------
# Domínio aceito no auto-cadastro e domínio remetente dos e-mails
DOMINIO_EMAIL=compraflow.com.br

# ----------------------------- SMTP ("esqueci minha senha") ------------------
# Sem SMTP, o link de reset aparece no log do container (admin pode repassá-lo)
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_DE=noreply@compraflow.com.br
SMTP_TLS=true

# ----------------------------- anexos ----------------------------------------
ANEXO_MAX_BYTES=10485760          # 10 MB

# ----------------------------- CORS ------------------------------------------
# Deixe vazio (SPA mesma origem). Ex.: "https://portal.cliente.com.br"
CORS_ORIGINS=

# ----------------------------- SSO corporativo (Microsoft Entra ID / OIDC) ---
# Híbrido: senha local continua valendo. Veja o passo a passo em DEPLOY.md
OIDC_ENABLED=false
OIDC_ISSUER=                      # ex.: https://login.microsoftonline.com/<TENANT-ID>/v2.0
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=                # ex.: https://compras.suaempresa.com.br/api/auth/sso/callback
OIDC_SPA_BASE=                    # ex.: https://compras.suaempresa.com.br
OIDC_SCOPES=openid profile email
SECRET_KEY=                       # OBRIGATÓRIA com SSO (string longa aleatória)

# ----------------------------- dados de demonstração -------------------------
# SEED_DEMO=true                   # cria usuários e requisições de exemplo (demo)
